{
    "name": "onramplab/laravel-security-model",
    "description": "A Laravel package providing security for Eloquent model",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "security",
        "encryption",
        "eloquent",
        "model"
    ],
    "authors": [
        {
            "name": "OnrampLab",
            "email": "dev@onramplab.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.258",
        "illuminate/console": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/encryption": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.83|^9.0|^10.0|^11.0|^12.0|^13.0",
        "paragonie/ciphersweet": "^3.4"
    },
    "require-dev": {
        "doctrine/dbal": "^3.6",
        "larastan/larastan": "^3.13",
        "mockery/mockery": "^1.5",
        "nunomaduro/phpinsights": "^2.15",
        "onramplab/onr-phpcs-laravel": "^1.2",
        "orchestra/testbench": "^6.48|^7.58|^8.39|^9.18|^10.12|^11.3",
        "phpmd/phpmd": "^3.0",
        "phpunit/phpunit": "^9.6|^10.5|^11.5|^12.5",
        "rector/rector": "^2.8",
        "squizlabs/php_codesniffer": "*"
    },
    "autoload": {
        "psr-4": {
            "OnrampLab\\SecurityModel\\": "src/",
            "OnrampLab\\SecurityModel\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OnrampLab\\SecurityModel\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.0-dev"
        },
        "laravel": {
            "providers": [
                "OnrampLab\\SecurityModel\\SecurityModelServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "psr2check": [
            "@php vendor/bin/phpcs --standard=PSR2 src/"
        ],
        "psr2autofix": [
            "@php vendor/bin/phpcbf --standard=PSR2 src/"
        ],
        "docs": [
            "@php tools/phpDocumentor"
        ],
        "insights": [
            "@php vendor/bin/phpinsights analyse --no-interaction"
        ],
        "insights:fix": [
            "@php vendor/bin/phpinsights analyse --no-interaction --fix"
        ],
        "dependencies:check": [
            "phpmd src text rulesets.xml"
        ],
        "rector": [
            "vendor/bin/rector process src --dry-run"
        ],
        "rector:fix": [
            "vendor/bin/rector process src"
        ]
    }
}
