includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./phpstan-baseline.neon

parameters:

    paths:
        - src

    # The level 8 is the highest level
    level: 8

    # ignoreErrors:
    #    - '#Unsafe usage of new static#'

    excludePaths:
        - ./*/*/tests/*.php
        - ./*/*/factories/*.php
        - ./*/*/migrations/*.php

    databaseMigrationsPath:
        - ./database/migrations

    ignoreErrors:
        -
            identifier: missingType.iterableValue
